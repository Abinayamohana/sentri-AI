# Copy to .env and fill in — `cp .env.example .env`, don't rename, this template belongs in git.
# Never commit .env: it holds the two credentials that exist to stay off the device.

# Console -> your project -> App ID. Also goes in the app's local.properties as agoraAppId.
AGORA_APP_ID=

# Console -> your project -> Security -> App Certificate. NEVER put this in the app.
# Required: once agoraBackendUrl is set, the app treats a missing token as an error.
AGORA_APP_CERTIFICATE=

# Console -> RESTful API. Account-level, not per project. NEVER put these in a release build.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# Optional. Set it and the app must send `Authorization: Bearer <value>` — which it does not yet
# do, so leaving this blank is the working configuration. See the README.
SENTRI_API_KEY=

# Optional. An hour by default; the app has no token renewal, so longer calls than this drop.
TOKEN_TTL_SECONDS=3600

# Attempt the inline-vendor path when the app sends no pipeline_id. Off by default: on this
# project it cannot succeed, and failing fast names the unset agoraPipelineId instead of hiding
# it behind an Agora vendor error. See "Vendor configuration" in the README.
ALLOW_INLINE_VENDORS=false

# Only used when ALLOW_INLINE_VENDORS=true and the app sends no pipeline_id.
# Every one of these must name a vendor your Agora project is actually provisioned for, and the
# whole block is guesswork you avoid entirely by publishing an Agent Studio agent and setting
# agoraPipelineId. See "Vendor configuration" in the README.
MANAGED_ASR_VENDOR=ares
MANAGED_ASR_LANGUAGE=en-US
MANAGED_LLM_VENDOR=openai
MANAGED_LLM_MODEL=gpt-4o-mini
MANAGED_TTS_VENDOR=microsoft
