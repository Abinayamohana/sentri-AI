<?xml version="1.0" encoding="utf-8"?><!-- The tinted button. Same size as Stop, lower contrast: snoozing is the secondary choice. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/reminder_accent_container_pressed" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/reminder_accent_container" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
