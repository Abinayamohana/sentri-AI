<?xml version="1.0" encoding="utf-8"?><!-- The filled button: Stop is the action that ends the reminder, so it reads as the default. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/reminder_accent_pressed" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/reminder_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
